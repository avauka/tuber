# Backend
DATABASE_URL=postgresql+psycopg://tuber:tuber@localhost:5433/tuber
SESSION_SECRET=change-me       # signiert das Session-Cookie (ADR 0005)
# argon2id-Hash. Erzeugen aus backend/: uv run python scripts/hash_password.py
AUTH_PASSWORD_HASH=
MEDIA_ROOT=./data/media
BASEMAP_PMTILES_PATH=./data/basemap.pmtiles
# Schema-Oberfläche unter /api/docs (hinter der Auth). Nur lokal, in der
# Produktion ungesetzt lassen. Alles ausser exakt "true" gilt als aus.
DOCS_ENABLED=false
# Backup (ADR 0004). Ohne Passphrase bricht der Dump-Job ab — es gibt keinen
# Fallback auf unverschlüsselt. Die Passphrase gehört zusätzlich in den
# Passwortmanager: ohne sie ist der Dump Datenmüll.
BACKUP_DIR=./data/backups
BACKUP_PASSPHRASE=
# Push (vorbereitet, inaktiv)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
PUSH_ENABLED=false
